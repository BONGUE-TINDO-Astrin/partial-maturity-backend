# SQL Server
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=belife_partial_maturity;encrypt=true;trustServerCertificate=true
DB_USERNAME=belife_app
DB_PASSWORD=change-me

# JWT
JWT_SECRET=replace-with-a-long-secure-random-secret
JWT_EXPIRATION=3600000

# Taux annuel : 0.035 = 3,5 %
INTEREST_ANNUAL_RATE=0.032

#Date de simulation
APPLICATION_BUSINESS_DATE=2023-03-15

# CORS
FRONTEND_URL=http://localhost:4200

# Profil Spring
SPRING_PROFILES_ACTIVE=local

# Logs
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APPLICATION=INFO
